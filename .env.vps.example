# Copy to .env.vps on the VPS; never commit the filled-in file.
SITE_DOMAIN=example.com
DJANGO_SETTINGS_MODULE=lala_land.settings.production
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=example.com
WAGTAILADMIN_BASE_URL=https://example.com
DEFAULT_FROM_EMAIL=website@example.com

DATABASE_ENGINE=postgresql
POSTGRES_DB=lala_land
POSTGRES_USER=lala_land
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_CONN_MAX_AGE=60

EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10

# Keep at zero until the real domain, HTTPS, and subdomains have been checked.
SECURE_HSTS_SECONDS=0
