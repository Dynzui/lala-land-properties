# Django
DJANGO_SETTINGS_MODULE=lala_land.settings.dev
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
WAGTAILADMIN_BASE_URL=http://localhost:8000
DEFAULT_FROM_EMAIL=notifications@example.com

# SMTP settings used in production for new-inquiry alerts.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-me
EMAIL_HOST_PASSWORD=replace-me
EMAIL_USE_TLS=true
EMAIL_TIMEOUT=10

# Local development may use sqlite. Staging and production must use postgresql.
DATABASE_ENGINE=postgresql
POSTGRES_DB=lala_land
POSTGRES_USER=lala_land
POSTGRES_PASSWORD=replace-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_CONN_MAX_AGE=60

# Production security rollout
SECURE_HSTS_SECONDS=31536000
